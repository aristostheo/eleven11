
// Firestore security rules (starter)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /posts/{postId} {
      // Writes only via Cloud Functions using Admin SDK; block direct client writes.
      allow create, update, delete: if false;
      // The read-only feed exposes active wishes only. Firestore evaluates this
      // against the query constraint as well as individual document reads.
      allow read: if resource.data.status == "active";
    }

    match /reports/{id} {
      allow create: if isSignedIn();
      allow read: if false;
    }
  }
}
