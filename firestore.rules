
// Firestore security rules (starter)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    match /posts/{postId} {
      // Writes only via Cloud Functions using Admin SDK; block direct client writes.
      allow create, update, delete: if false;
      // New shared-feed and history results are callable-shaped so they never
      // expose owner UIDs. Owners may still read their own document directly.
      // Legacy active documents, which predate visibility, retain their old
      // shared direct-read behavior until a reviewed migration labels them.
      allow read: if resource.data.status == "active"
                  && (isOwner(resource.data.uid)
                      || !resource.data.keys().hasAny(["visibility"]));

      // Reactions are an internal per-viewer identity map. Cloud Functions
      // alone may create/delete these records and update aggregate counts.
      match /reactions/{uid} {
        allow read, write: if false;
      }
    }

    match /reports/{id} {
      // Reports and decisions are callable-only. This prevents report details
      // and reporter identities from reaching authors or regular viewers.
      allow read, write: if false;
    }
  }
}
